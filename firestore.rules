rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 신원 확인 ----
    // 학생: 이메일/비밀번호로 가입했고 students 컬렉션에 등록된 사람
    function isStudent() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }
    // 교직원: staff 컬렉션에 등록된 사람. 담임은 직접 가입할 수 있고, 그 외 결재자는 관리자가 만든다.
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function isPasswordAuth() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    function myStaff() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    function isManager() {
      return isStaff() && myStaff().canManage == true;
    }
    function isOwner(data) {
      return isStudent() && data.ownerUid == request.auth.uid;
    }
    function isHomeroomTeacher() {
      return isStaff() && myStaff().step == 0;
    }
    function homeroomMatches(data) {
      return isHomeroomTeacher()
        && data.application.grade == myStaff().grade
        && data.application.classroom == myStaff().classroom;
    }
    function canReadApplication(data) {
      return isOwner(data)
        || isManager()
        || (isStaff() && myStaff().step in [1, 2, 3])
        || homeroomMatches(data);
    }
    function canReadApplicationId(appId) {
      return exists(/databases/$(database)/documents/applications/$(appId))
        && canReadApplication(get(/databases/$(database)/documents/applications/$(appId)).data);
    }

    // ---- 결재 도우미 ----
    // 4단계 결재가 개정번호 rev 기준으로 모두 끝났는지
    function fullyApproved(appId, rev) {
      let p = /databases/$(database)/documents/approvals/$(appId);
      return exists(p)
        && get(p).data.appRev == rev
        && get(p).data.rejected == false
        && get(p).data.steps.size() == 4
        && get(p).data.steps[0].approved == true
        && get(p).data.steps[1].approved == true
        && get(p).data.steps[2].approved == true
        && get(p).data.steps[3].approved == true;
    }
    // 내 단계(my) 외의 칸은 건드리지 못한다
    function keep(o, n, my, i) { return i == my || n[i] == o[i]; }
    function othersUnchanged(o, n, my) {
      return keep(o, n, my, 0) && keep(o, n, my, 1) && keep(o, n, my, 2) && keep(o, n, my, 3);
    }
    function off(n, my, i) { return i == my || n[i].approved == false; }
    function othersNotApproved(n, my) {
      return off(n, my, 0) && off(n, my, 1) && off(n, my, 2) && off(n, my, 3);
    }

    // ---- 교직원 명단 ----
    match /students/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isManager();
      allow list: if isManager();
      allow create: if isPasswordAuth()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'grade', 'classroom', 'phone', 'email', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.grade is string
        && request.resource.data.classroom is string
        && request.resource.data.phone is string;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'grade', 'classroom', 'phone']);
      allow delete: if isManager();
    }

    // ---- 교직원 명단 ----
    match /staff/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isManager());
      allow list: if isManager();
      // 담임 자가 가입: 본인 문서만 만들 수 있고, 담임(step 0) 권한만 받는다.
      // 관리자 생성: 담임 계정에는 학년/반을 넣고, 상위 결재자는 비워 둘 수 있다.
      allow create: if (request.auth != null
              && isPasswordAuth()
              && request.auth.uid == uid
              && request.resource.data.keys().hasOnly(['id', 'name', 'step', 'grade', 'classroom', 'homeroomKey', 'canManage', 'mustChange', 'selfRegistered', 'createdAt'])
              && request.resource.data.step == 0
              && request.resource.data.canManage == false
              && request.resource.data.mustChange == false
              && request.resource.data.grade is string
              && request.resource.data.classroom is string)
        || (isManager()
              && request.resource.data.keys().hasOnly(['id', 'name', 'step', 'grade', 'classroom', 'homeroomKey', 'canManage', 'mustChange', 'createdAt'])
              && request.resource.data.step in [0, 1, 2, 3]);
      // 본인: 비밀번호를 바꾼 뒤 mustChange만 false로
      // 관리자: 이름, 단계, 변경 안내 여부
      allow update: if (request.auth.uid == uid && isStaff()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange'])
              && request.resource.data.mustChange == false)
        || (isManager()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'step', 'mustChange']));
      allow delete: if isManager() && request.auth.uid != uid;
    }

    // ---- 신청서 / 결과보고서 ----
    match /applications/{appId} {
      allow read: if canReadApplication(resource.data);

      allow create: if isStudent()
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerEmail', 'createdAt', 'rev', 'application', 'report', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.rev == 1
        && request.resource.data.report.submitted == false;

      allow update: if isOwner(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerEmail', 'createdAt', 'rev', 'application', 'report', 'updatedAt'])
        && (
          // 결재가 끝나기 전: 신청서를 수정할 수 있다. 개정번호가 1 올라가 기존 결재는 무효가 된다.
          (!fullyApproved(appId, resource.data.rev)
            && request.resource.data.rev == resource.data.rev + 1
            && request.resource.data.report == resource.data.report)
          ||
          // 결재가 끝난 뒤: 신청서는 고정, 결과보고서만 쓸 수 있다.
          (fullyApproved(appId, resource.data.rev)
            && request.resource.data.rev == resource.data.rev
            && request.resource.data.application == resource.data.application)
        );

      allow delete: if isOwner(resource.data) && !fullyApproved(appId, resource.data.rev);
    }

    // ---- 결재 기록: 교직원만 쓰고, 각자 자기 단계 칸만 바꾼다 ----
    match /approvals/{appId} {
      allow read: if isOwner(resource.data) || (isStaff() && canReadApplicationId(appId));

      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['ownerUid', 'appRev', 'steps', 'rejected', 'note', 'homeroomGrade', 'homeroomClassroom', 'homeroomKey', 'updatedAt'])
        && exists(/databases/$(database)/documents/applications/$(appId))
        && canReadApplicationId(appId)
        && request.resource.data.appRev == get(/databases/$(database)/documents/applications/$(appId)).data.rev
        && request.resource.data.ownerUid == get(/databases/$(database)/documents/applications/$(appId)).data.ownerUid
        && request.resource.data.steps.size() == 4
        && othersNotApproved(request.resource.data.steps, myStaff().step);

      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['ownerUid', 'appRev', 'steps', 'rejected', 'note', 'homeroomGrade', 'homeroomClassroom', 'homeroomKey', 'updatedAt'])
        && canReadApplicationId(appId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.appRev == get(/databases/$(database)/documents/applications/$(appId)).data.rev
        && request.resource.data.steps.size() == 4
        && (request.resource.data.appRev == resource.data.appRev
              ? othersUnchanged(resource.data.steps, request.resource.data.steps, myStaff().step)
              : othersNotApproved(request.resource.data.steps, myStaff().step));

      allow delete: if isManager();
    }

    match /photos/{appId} {
      allow read: if isOwner(resource.data) || (isStaff() && canReadApplicationId(appId));
      allow create, update: if isStudent()
        && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'data'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.data.size() < 400000
        && exists(/databases/$(database)/documents/applications/$(appId))
        && get(/databases/$(database)/documents/applications/$(appId)).data.ownerUid == request.auth.uid;
      allow delete: if isManager() || isOwner(resource.data);
    }
  }
}
